{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spine-packs.local/contracts/schemas/spine-pack-manifest.v2.schema.json",
  "title": "Spine Pack Manifest v2 (draft, FR-1 manifest slice)",
  "type": "object",
  "required": [
    "manifest_schema",
    "pack",
    "compatibility",
    "dependencies",
    "archetypes",
    "notification_profiles",
    "binding_intents",
    "content_identity",
    "facet_schemas",
    "archetype_facet_bindings",
    "rendering_definitions"
  ],
  "properties": {
    "manifest_schema": {
      "const": "spine.pack-manifest.v2"
    },
    "pack": {
      "$ref": "#/$defs/pack"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 0
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/archetype"
      }
    },
    "notification_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/notificationProfile"
      }
    },
    "binding_intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/bindingIntent"
      }
    },
    "content_identity": {
      "$ref": "#/$defs/contentIdentity"
    },
    "facet_schemas": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/facetSchema"
      }
    },
    "archetype_facet_bindings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/facetBinding"
      }
    },
    "rendering_definitions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/renderingDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "stableVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "draftVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-draft\\.[1-9][0-9]*$"
    },
    "pack": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "pack_id",
            "version",
            "status"
          ],
          "properties": {
            "pack_id": {
              "$ref": "#/$defs/packId"
            },
            "version": {
              "$ref": "#/$defs/draftVersion"
            },
            "status": {
              "const": "draft"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "pack_id",
            "version",
            "status"
          ],
          "properties": {
            "pack_id": {
              "$ref": "#/$defs/packId"
            },
            "version": {
              "$ref": "#/$defs/stableVersion"
            },
            "status": {
              "const": "released"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "required": [
        "spine_runtime_versions",
        "spine_content_contracts"
      ],
      "properties": {
        "spine_runtime_versions": {
          "enum": [
            [
              "0.9.1"
            ],
            [
              "0.10.0"
            ],
            [
              "0.12.0"
            ]
          ]
        },
        "spine_content_contracts": {
          "const": [
            "spine.archetype-facet-bindings.v1",
            "spine.facet-schemas.v1",
            "spine.item-archetypes.v1",
            "spine.notification-profile-bindings.v1",
            "spine.notification-profiles.v2",
            "spine.notification-rendering-definitions.v1",
            "spine.notification-rendering.v1"
          ]
        }
      },
      "additionalProperties": false
    },
    "itemTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "event",
          "task"
        ]
      }
    },
    "description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "archetypeRevision": {
      "type": "object",
      "required": [
        "display_name",
        "description",
        "compatible_item_types"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "compatible_item_types": {
          "$ref": "#/$defs/itemTypes"
        }
      },
      "additionalProperties": false
    },
    "archetype": {
      "type": "object",
      "required": [
        "archetype_key",
        "intended_status",
        "revision"
      ],
      "properties": {
        "archetype_key": {
          "$ref": "#/$defs/key"
        },
        "intended_status": {
          "const": "active"
        },
        "revision": {
          "$ref": "#/$defs/archetypeRevision"
        }
      },
      "additionalProperties": false
    },
    "elapsedAtOrBeforeSchedule": {
      "type": "object",
      "required": [
        "kind",
        "at"
      ],
      "properties": {
        "kind": {
          "const": "once"
        },
        "at": {
          "type": "object",
          "required": [
            "kind",
            "offset_basis",
            "offset_seconds"
          ],
          "properties": {
            "kind": {
              "const": "target_offset"
            },
            "offset_basis": {
              "const": "elapsed"
            },
            "offset_seconds": {
              "type": "string",
              "pattern": "^(?:0|-[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calendarDaySchedule": {
      "type": "object",
      "required": [
        "kind",
        "at"
      ],
      "properties": {
        "kind": {
          "const": "once"
        },
        "at": {
          "type": "object",
          "required": [
            "kind",
            "offset_basis",
            "offset_days",
            "local_time"
          ],
          "properties": {
            "kind": {
              "const": "target_offset"
            },
            "offset_basis": {
              "const": "calendar_days"
            },
            "offset_days": {
              "type": "string",
              "pattern": "^(?:0|-[1-9][0-9]{0,3})$"
            },
            "local_time": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lateHandling": {
      "type": "object",
      "required": [
        "kind",
        "grace_seconds"
      ],
      "properties": {
        "kind": {
          "const": "deliver_within"
        },
        "grace_seconds": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": [
        "template_key",
        "schedule",
        "late_handling",
        "rendering"
      ],
      "properties": {
        "template_key": {
          "$ref": "#/$defs/key"
        },
        "schedule": {
          "oneOf": [
            {
              "$ref": "#/$defs/elapsedAtOrBeforeSchedule"
            },
            {
              "$ref": "#/$defs/calendarDaySchedule"
            }
          ]
        },
        "late_handling": {
          "$ref": "#/$defs/lateHandling"
        },
        "rendering": {
          "$ref": "#/$defs/templateRendering"
        }
      },
      "additionalProperties": false
    },
    "profileRevision": {
      "type": "object",
      "required": [
        "compatible_item_types",
        "templates"
      ],
      "properties": {
        "compatible_item_types": {
          "$ref": "#/$defs/itemTypes"
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/template"
          }
        }
      },
      "additionalProperties": false
    },
    "notificationProfile": {
      "type": "object",
      "required": [
        "profile_key",
        "display_name",
        "description",
        "intended_status",
        "revision"
      ],
      "properties": {
        "profile_key": {
          "$ref": "#/$defs/key"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "intended_status": {
          "const": "active"
        },
        "revision": {
          "$ref": "#/$defs/profileRevision"
        }
      },
      "additionalProperties": false
    },
    "bindingIntent": {
      "type": "object",
      "required": [
        "binding_kind",
        "archetype_key",
        "notification_profile_key"
      ],
      "properties": {
        "binding_kind": {
          "const": "archetype_default"
        },
        "archetype_key": {
          "$ref": "#/$defs/key"
        },
        "notification_profile_key": {
          "$ref": "#/$defs/key"
        }
      },
      "additionalProperties": false
    },
    "contentIdentity": {
      "type": "object",
      "required": [
        "algorithm",
        "canonical_json_version",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonical_json_version": {
          "const": "spine.canonical-json.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "facetKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "facetInteger": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])",
      "maxLength": 20,
      "$comment": "Semantic validation enforces signed 64-bit range."
    },
    "facetField": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "max_length",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "text"
            },
            "queryable": {
              "type": "boolean"
            },
            "max_length": {
              "type": "string",
              "pattern": "^([1-9]|[1-9][0-9]{1,2}|10[01][0-9]|102[0-4])(?![\\s\\S])"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "choices",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "enum"
            },
            "queryable": {
              "type": "boolean"
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "boolean"
            },
            "queryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "min",
            "max",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "integer"
            },
            "queryable": {
              "type": "boolean"
            },
            "min": {
              "$ref": "#/$defs/facetInteger"
            },
            "max": {
              "$ref": "#/$defs/facetInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "date"
            },
            "queryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "key",
            "required",
            "type",
            "target_kind",
            "queryable"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/facetKey"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "reference"
            },
            "queryable": {
              "type": "boolean"
            },
            "target_kind": {
              "enum": [
                "subject",
                "location"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "facetDefinition": {
      "type": "object",
      "required": [
        "display_name",
        "description",
        "compatible_item_types",
        "fields"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "compatible_item_types": {
          "type": "array",
          "items": {
            "enum": [
              "event",
              "task"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/facetField"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "schema_key"
      ],
      "properties": {
        "schema_key": {
          "$ref": "#/$defs/facetKey"
        }
      },
      "additionalProperties": false
    },
    "facetSchema": {
      "type": "object",
      "required": [
        "schema_key",
        "intended_status",
        "definition"
      ],
      "properties": {
        "schema_key": {
          "$ref": "#/$defs/facetKey"
        },
        "intended_status": {
          "const": "active"
        },
        "definition": {
          "$ref": "#/$defs/facetDefinition"
        }
      },
      "additionalProperties": false
    },
    "facetBinding": {
      "type": "object",
      "required": [
        "archetype_key",
        "facet_key",
        "schema_ref"
      ],
      "properties": {
        "archetype_key": {
          "$ref": "#/$defs/key"
        },
        "facet_key": {
          "$ref": "#/$defs/facetKey"
        },
        "schema_ref": {
          "$ref": "#/$defs/schemaRef"
        }
      },
      "additionalProperties": false
    },
    "renderingSelection": {
      "type": "object",
      "required": [
        "selection_key",
        "facet_key",
        "schema_ref",
        "field_key",
        "label",
        "projection"
      ],
      "properties": {
        "selection_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "facet_key": {
          "$ref": "#/$defs/facetKey"
        },
        "field_key": {
          "$ref": "#/$defs/facetKey"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "projection": {
          "enum": [
            "value",
            "location_label"
          ]
        },
        "schema_ref": {
          "$ref": "#/$defs/schemaRef"
        }
      },
      "additionalProperties": false
    },
    "renderingRevision": {
      "type": "object",
      "required": [
        "display_name",
        "description",
        "compatible_item_types",
        "base_rendering_contract",
        "base_rendering_profile",
        "selections"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "compatible_item_types": {
          "type": "array",
          "items": {
            "enum": [
              "event",
              "task"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "base_rendering_contract": {
          "const": "spine.notification-rendering.v1"
        },
        "base_rendering_profile": {
          "const": "spine.notification-rendering.concise-en-ca.v1"
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/renderingSelection"
          }
        }
      },
      "additionalProperties": false
    },
    "renderingDefinition": {
      "type": "object",
      "required": [
        "definition_key",
        "intended_status",
        "revision"
      ],
      "properties": {
        "definition_key": {
          "$ref": "#/$defs/key"
        },
        "intended_status": {
          "const": "active"
        },
        "revision": {
          "$ref": "#/$defs/renderingRevision"
        }
      },
      "additionalProperties": false
    },
    "templateRendering": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ordinary"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "definition_ref"
          ],
          "properties": {
            "kind": {
              "const": "definition"
            },
            "definition_ref": {
              "type": "object",
              "required": [
                "definition_key"
              ],
              "properties": {
                "definition_key": {
                  "$ref": "#/$defs/key"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$comment": "Draft manifest-only codification of specs/facet-rendering-packs.md. Exact Spine 57cda1c2d5589360ee8efe7155fd20b503034c2a, runtime 0.9.1/schema 19. Not installer runtime support. Facet definition/key/integer/field fragments derive from archetype-facet-types.schema.json; rendering revision/selection fragments from notification-rendering-definition-types.schema.json, with portable references substituted. Normalization, graph, ordering and digest rules require semantic validation. FR-2 adds an exact 0.10.0 encoding at 8f3c50b6fd1b4aa534e50925b7417a7a80d19122. 0.9.1 remains decodable solely for historical FR-1 fixtures; current successor planning rejects it. No runtime range or v1 compatibility expansion. AL-1 adds contract-only exact 0.12.0/schema 20 at 3e65ef0de9e73b62047a0f6328731db08ca91023, governed by specs/spine-0.12.0-alignment.md. Existing runtime admission remains exact 0.10.0 pending review and AL-2 routing."
}
